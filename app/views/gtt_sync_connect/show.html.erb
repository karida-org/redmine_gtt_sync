<% html_title l(:label_gtt_sync_connect) %>

<% content_for :header_tags do %>
  <%= javascript_include_tag 'gtt_sync_connect', plugin: 'redmine_gtt_sync' %>
<% end %>

<h2><%= l(:label_gtt_sync_connect) %></h2>

<% if @client_id.present? %>
  <%# Full connection details: only meaningful once an OAuth app is published. %>
  <p><%= l(:text_gtt_sync_connect_intro) %></p>

  <table class="list">
    <tbody>
      <tr>
        <th><%= l(:label_gtt_sync_connect_url) %></th>
        <%= gtt_sync_copy_cell(@base_url, l(:label_gtt_sync_connect_url)) %>
      </tr>
      <tr>
        <th><%= l(:label_gtt_sync_connect_client_id) %></th>
        <%= gtt_sync_copy_cell(@client_id, l(:label_gtt_sync_connect_client_id)) %>
      </tr>
      <tr>
        <th><%= l(:label_gtt_sync_connect_scopes) %></th>
        <%= gtt_sync_copy_cell(@scopes.join(' '), l(:label_gtt_sync_connect_scopes)) %>
      </tr>
    </tbody>
  </table>

  <p>
    <%= link_to l(:button_gtt_sync_download_qgis_config),
                gtt_sync_connect_qgis_config_path,
                class: 'icon icon-download' %>
  </p>

  <p class="info"><%= l(:text_gtt_sync_connect_instructions) %></p>
<% else %>
  <%# No client ID yet: withhold the URL/scopes/instructions so nobody tries to
      set up a connection that cannot work, and instead point at the real fix.
      An admin can act on it directly; anyone else is told who to ask. %>
  <% if User.current.admin? %>
    <p class="warning"><%= l(:text_gtt_sync_connect_no_client_id_admin) %></p>
    <p>
      <%= link_to l(:button_gtt_sync_configure_oauth_application),
                  plugin_settings_path(id: 'redmine_gtt_sync'),
                  class: 'icon icon-settings' %>
    </p>
  <% else %>
    <p class="warning"><%= l(:text_gtt_sync_connect_no_client_id) %></p>
  <% end %>
<% end %>
