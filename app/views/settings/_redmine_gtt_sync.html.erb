<%
  # Only public (non-confidential) apps are eligible: a public PKCE client_id is
  # not a secret and is safe to advertise; a confidential client's id must not be.
  public_apps = Doorkeeper::Application.where(confidential: false).order(:name)
%>

<%# Redmine renders this partial inside its own `.box.tabular` wrapper, which
    lays each <p> out as a right-aligned label column plus a field column. So we
    do NOT add another `.tabular` (that would nest the grid), and the intro is a
    <div> (not a <p>) to stay out of the grid and read full width. The scoped
    rule pins each row label to the top, so it lines up with the first line of a
    tall, multi-line field instead of floating against its middle. %>
<style>
  .plugin-redmine_gtt_sync .gtt-sync-intro { margin: 0 0 1.2em; }
  .plugin-redmine_gtt_sync .gtt-sync-section-heading { margin: 1.2em 0 0.6em; }
  /* Redmine's `#content .tabular label` rule adds a top margin to centre the
     label against input boxes; its ID scope outranks a class selector, so match
     that scope here to reset it and top-align each label with its field. */
  #content .plugin-redmine_gtt_sync .tabular > p > label { margin-top: 0; }
</style>

<div class="gtt-sync-intro"><%= l(:text_gtt_sync_oauth_intro) %></div>

<%# QTask renders Markdown itself; on a Textile instance that would be wrong, so
    it disables the Markdown editor/preview there. Warn admins so the fix (switch
    the instance to CommonMark) is discoverable. %>
<% unless RedmineGttSync::Capabilities.formatting_info[:markdown] %>
  <div class="warning gtt-sync-intro"><%= l(:text_gtt_sync_textile_warning) %></div>
<% end %>

<h4 class="gtt-sync-section-heading"><%= l(:label_gtt_sync_oauth_section_desktop) %></h4>
<%= render partial: 'settings/gtt_sync_oauth_section',
           locals: {
             public_apps: public_apps,
             settings: @settings,
             section: {
               setting_key: 'oauth_application_uid',
               create_path: gtt_sync_create_oauth_application_path,
               status_label: :label_gtt_sync_oauth_status,
               status_ready: :text_gtt_sync_oauth_status_ready,
               status_off: :text_gtt_sync_oauth_status_off,
               select_label: :label_gtt_sync_oauth_application,
               select_hint: :text_gtt_sync_oauth_application_hint,
               button_label: :button_gtt_sync_create_oauth_application,
               button_hint: :text_gtt_sync_create_oauth_application_hint,
               scope_label: :label_gtt_sync_oauth_scope_status,
               scopes_granted: :text_gtt_sync_oauth_scopes_granted,
               scopes_ungranted: :text_gtt_sync_oauth_scopes_ungranted
             }
           } %>

<h4 class="gtt-sync-section-heading"><%= l(:label_gtt_sync_oauth_section_mobile) %></h4>
<div class="gtt-sync-intro"><%= l(:text_gtt_sync_mobile_oauth_intro) %></div>
<%= render partial: 'settings/gtt_sync_oauth_section',
           locals: {
             public_apps: public_apps,
             settings: @settings,
             section: {
               setting_key: 'oauth_mobile_application_uid',
               create_path: gtt_sync_create_mobile_oauth_application_path,
               status_label: :label_gtt_sync_mobile_oauth_status,
               status_ready: :text_gtt_sync_mobile_oauth_status_ready,
               status_off: :text_gtt_sync_mobile_oauth_status_off,
               select_label: :label_gtt_sync_mobile_oauth_application,
               select_hint: :text_gtt_sync_mobile_oauth_application_hint,
               button_label: :button_gtt_sync_create_mobile_oauth_application,
               button_hint: :text_gtt_sync_create_mobile_oauth_application_hint,
               scope_label: :label_gtt_sync_mobile_oauth_scope_status,
               scopes_granted: :text_gtt_sync_mobile_oauth_scopes_granted,
               scopes_ungranted: :text_gtt_sync_mobile_oauth_scopes_ungranted
             }
           } %>

<% if public_apps.empty? %>
  <p><em class="info"><%= l(:text_gtt_sync_oauth_no_public_apps) %></em></p>
<% end %>
